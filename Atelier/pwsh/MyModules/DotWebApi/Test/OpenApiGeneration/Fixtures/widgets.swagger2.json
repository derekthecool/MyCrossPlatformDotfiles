{
  "swagger": "2.0",
  "info": { "title": "Widget Service", "version": "1.0" },
  "host": "widgets.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "key": { "type": "apiKey", "in": "header", "name": "X-Key" }
  },
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "parameters": [
          {
            "name": "color",
            "in": "query",
            "type": "string",
            "enum": ["red", "blue"]
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/Widget" }
            }
          }
        }
      },
      "post": {
        "operationId": "createWidget",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Widget" }
          }
        ],
        "responses": {
          "201": {
            "description": "created",
            "schema": { "$ref": "#/definitions/Widget" }
          }
        }
      }
    },
    "/widgets/{id}/blueprint": {
      "post": {
        "operationId": "uploadBlueprint",
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" },
          {
            "name": "blueprint",
            "in": "formData",
            "type": "file",
            "required": true
          },
          { "name": "note", "in": "formData", "type": "string" }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "definitions": {
    "Widget": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "weight": { "type": "number", "minimum": 0 }
      }
    }
  }
}
